# Discord bot credentials (Discord Developer Portal -> your application)
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# Optional: set for instant command updates during development (guild-scoped).
# Leave blank to register commands globally (takes up to ~1 hour to propagate).
DISCORD_GUILD_ID=

# Name shown to buyers and returned by the verify API.
PRODUCT_NAME=My Addon

# Where the SQLite database file is stored.
DB_PATH=./licenses.db

# HTTP port the verification API listens on.
PORT=3001

# Shared secret the mod must send as the X-Api-Key header when calling /verify.
# Raises the bar against casual scanning of the endpoint. Not a substitute for
# rate limiting, and not secret from someone who decompiles the mod jar.
LICENSE_API_KEY=
